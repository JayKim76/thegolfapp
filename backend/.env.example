# Copy to .env and change the password/token before real use.
DATABASE_URL="file:./dev.db"
PORT=3000

# Single club admin account (members do not have accounts)
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me-too

# Scorecard OCR (Gemini vision). Server-side only — never put this in the app.
GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.5-flash
