# --- Supabase (PostgreSQL) ---
# Runtime: transaction pooler (Supabase dashboard > Database > Connection string > Transaction)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations & seed: session pooler (same host, port 5432)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"
# Local dev against a local Postgres works too, e.g.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thegolfapp" and DIRECT_URL same.

PORT=3000

# Single-admin account (this app has exactly one club and one admin)
ADMIN_ID=admin
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me-to-a-long-random-string

# Scorecard OCR (Gemini vision). Server-side only — never put this in the app.
GEMINI_API_KEY=
# GEMINI_OCR_MODEL=gemini-2.5-flash
