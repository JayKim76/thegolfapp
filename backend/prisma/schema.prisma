// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // native: local dev; rhel-openssl-3.0.x: Vercel serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime (Vercel): Supabase TRANSACTION pooler (port 6543, ?pgbouncer=true)
  url       = env("DATABASE_URL")
  // Migrations/seed: Supabase SESSION pooler (port 5432) or direct connection
  directUrl = env("DIRECT_URL")
}

model Club {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     Member[]
}

model Member {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?  @unique
  clubId      Int      @default(1)
  club        Club     @relation(fields: [clubId], references: [id])
  handicap    Float    @default(0)
  phone       String?
  joinDate    DateTime @default(now())
  status      String   @default("active") // active, inactive, offline
  profileImage String?
  badges      String?  // Stored as JSON string for simple badges array
  type        String   @default("Regular") // 정회원, 준회원 etc.
  intro       String?
  gender      String   @default("male") // male, female
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groups      Group[] 
  rounds      Round[]
}

model Schedule {
  id          Int      @id @default(autoincrement())
  date        String
  time        String?
  courseName  String
  memo        String?
  groups      Group[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  scheduleId  Int
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  members     Member[]
}

// One outing recorded by the admin. A session owns one score record
// (Round) per player, so a round is stored once and read back per member.
model RoundSession {
  id          Int      @id @default(autoincrement())
  date        String   // YYYY-MM-DD
  courseName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scores      Round[]
}

model Round {
  id          Int           @id @default(autoincrement())
  memberId    Int?
  member      Member?       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  guestName   String?       // Set when the player is not a registered member
  sessionId   Int?
  session     RoundSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  date        String        // YYYY-MM-DD
  courseName  String?
  score       Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}


model GolfCourse {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  distance    String? // Display string for now
}
